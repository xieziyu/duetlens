{
  "name": "duetlens",
  "productName": "Duetlens",
  "version": "0.10.0",
  "description": "Conversational code review — human and agent reviewing together (full rewrite of better-review)",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --dir --arm64 -c.mac.identity=- -c.mac.notarize=false -c.mac.entitlements=build/entitlements.mac.dev.plist -c.mac.entitlementsInherit=build/entitlements.mac.dev.plist",
    "dist": "npm run build && electron-builder --mac --publish never",
    "release": "npm run build && electron-builder --mac --publish always",
    "preview:ui": "vite --config vite.preview.config.ts --port 5177 --strictPort",
    "site:dev": "vite --config vite.site.config.ts --port 5178 --strictPort",
    "site:build": "vite build --config vite.site.config.ts",
    "db:snapshot": "bash scripts/db-snapshot.sh",
    "icons:gen": "tsx scripts/gen-icons.ts",
    "rebuild:electron": "npm run rebuild:clean-meta && electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3 && npm run rebuild:clean-meta",
    "rebuild:clean-meta": "rm -f node_modules/*/build/Release/.forge-meta",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx .",
    "spike:codex": "tsx scripts/spike-codex.ts",
    "spike:reasoning": "tsx scripts/spike-reasoning-summary.ts",
    "spike:db": "tsx scripts/spike-db.ts",
    "spike:diff": "tsx scripts/spike-diff.ts",
    "spike:review": "tsx scripts/spike-review.ts",
    "spike:discussion": "tsx scripts/spike-discussion.ts",
    "spike:resume": "tsx scripts/spike-resume.ts",
    "spike:gitbutler": "tsx scripts/spike-gitbutler.ts",
    "spike:source": "tsx scripts/spike-source.ts",
    "spike:base-ref": "tsx scripts/spike-base-ref.ts",
    "spike:mcp": "tsx scripts/spike-mcp.ts",
    "spike:session-events": "tsx scripts/spike-session-events.ts",
    "spike:write": "tsx scripts/spike-write.ts",
    "spike:ui-state": "tsx scripts/spike-ui-state.ts",
    "spike:promote": "tsx scripts/spike-promote.ts",
    "spike:prompt": "tsx scripts/spike-prompt.ts",
    "spike:export": "tsx scripts/spike-export.ts",
    "spike:submit": "tsx scripts/spike-submit.ts",
    "spike:add-finding": "tsx scripts/spike-add-finding.ts",
    "spike:notify": "tsx scripts/spike-notify.ts",
    "spike:rerun": "tsx scripts/spike-rerun.ts",
    "spike:absorb": "tsx scripts/spike-absorb.ts",
    "spike:adversarial": "tsx scripts/spike-adversarial.ts",
    "spike:stop-scan": "tsx scripts/spike-stop-scan.ts",
    "spike:sandbox-guard": "tsx scripts/spike-sandbox-guard.ts",
    "spike:session-busy": "tsx scripts/spike-session-busy.ts",
    "spike:followup-queue": "tsx scripts/spike-followup-queue.ts",
    "spike:proposals": "tsx scripts/spike-proposals.ts",
    "spike:reply-stream": "tsx scripts/spike-reply-stream.ts",
    "codex:gen-types": "codex app-server generate-ts --out src/backend/agent/codex/generated"
  },
  "keywords": [],
  "author": {
    "name": "xieziyu",
    "email": "rainnyxzy@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "highlight.js": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "zod": "^4.4.3"
  }
}
